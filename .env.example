# Copy to .env. Use a DEVELOPMENT Neon/PostgreSQL database, never a production database.
# Neon: use sslmode=verify-full. Keep credentials out of Git and browser configuration.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&schema=akgebeya_foundation"
# Optional direct (non-pooler) URL for migrations. Defaults to DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full&schema=akgebeya_foundation"
