{
  "name": "@akgebeya/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-prisma-engine.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:inspect": "tsx prisma/inspect.ts",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:database": "tsx --test test/database/*.test.ts",
    "verify:auth": "tsx scripts/verify-auth.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "prisma": "6.12.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
