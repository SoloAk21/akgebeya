NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=

# Local development example; replace both URLs with your database credentials.
DATABASE_URL=postgresql://localhost:5432/akgebeya?schema=akgebeya
DIRECT_URL=postgresql://localhost:5432/akgebeya?schema=akgebeya
# Neon: DATABASE_URL uses the pooled host; DIRECT_URL uses the direct host.
# Keep sslmode=require on both Neon URLs. Never commit real connection strings.

# Generate a random base64url key (32+ bytes) locally; no default signing secret.
AUTH_JWT_SECRET=
AUTH_SESSION_TTL_SECONDS=3600

# Required by server startup. Keep the real bot token only in .env or your secret manager.
TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=300

# No SMS provider is implemented. Production phone login stays unavailable.
PHONE_OTP_TRANSPORT=disabled
PHONE_OTP_HASH_SECRET=
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_COOLDOWN_SECONDS=60
PHONE_OTP_MAX_ATTEMPTS=5
# test-ipc is only for a development/test child with a private IPC channel.

# Google ID-token login is unavailable until a client ID is configured.
# GOOGLE_CLIENT_ID=your-client.apps.googleusercontent.com
# No client secret is required by the ID-token verification endpoint.

# Provider review request expires after 7 days; approval after 90 days.
PROVIDER_PENDING_TTL_SECONDS=604800
PROVIDER_APPROVAL_TTL_SECONDS=7776000
# Backend-only Gemini settings; configure values only in ignored .env.
GEMINI_API_KEY=
GEMINI_MODEL=

# Backend-only Chapa initialization. Use development/test credentials privately.
CHAPA_SECRET_KEY=
CHAPA_BASE_URL= https://api.chapa.co/v1
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=
