NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=

# Local development example; replace both URLs with your database credentials.
DATABASE_URL=postgresql://localhost:5432/akgebeya?schema=akgebeya
DIRECT_URL=postgresql://localhost:5432/akgebeya?schema=akgebeya
# Neon: DATABASE_URL uses the pooled host; DIRECT_URL uses the direct host.
# Keep sslmode=require on both Neon URLs. Never commit real connection strings.
