          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Expected HTTP 201. Expected JSON (placeholders denote generated values):{\n  \"provider\": {\n    \"id\": \"<provider-uuid>\",\n    \"role\": \"OWNER\",\n    \"nameEn\": \"<English name>\",\n    \"nameAm\": \"<Amharic name or null>\",\n    \"descriptionEn\": null,\n    \"descriptionAm\": null,\n    \"status\": \"PENDING\",\n    \"verification\": {\n      \"id\": null,\n      \"state\": \"UNVERIFIED\",\n      \"verified\": false,\n      \"reviewedAt\": null,\n      \"expiresAt\": null\n    }\n  }\n}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Server-derived state', () => { const v = body.verification || body.provider.verification; pm.expect(v.state).to.equal('UNVERIFIED'); pm.expect(v.verified).to.equal(false); pm.expect(v).not.to.have.property('reviewerId'); pm.expect(v).not.to.have.property('tokenHash'); });",
              "pm.variables.set('providerId', body.provider.id);"
            ]
          }
        }
      ]
    },
