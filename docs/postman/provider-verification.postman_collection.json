{
  "info": {
    "name": "AkGebeya Step 4.5 Provider Verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Development-only sequential collection. Start scripts/verify-provider.ts. Never sync or export populated credentials."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "fixtureUrl",
      "value": ""
    },
    {
      "key": "fixtureKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('ownerToken')) {",
          "pm.sendRequest({url: pm.variables.get('fixtureUrl') + '/credentials', method:'POST', header:{Authorization:'Bearer ' + pm.variables.get('fixtureKey')}}, function(error, response) {",
          "if (error || response.code !== 200) throw new Error('Private development fixture unavailable');",
          "const tokens = response.json();",
          "['owner','other','admin'].forEach(actor => pm.variables.set(actor + 'Token', tokens[actor]));",
          "});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Unauthenticated creation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/providers",
        "body": {
          "mode": "raw",
          "raw": "{\"role\":\"OWNER\",\"nameEn\":\"Provider fixture\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Expected HTTP 401. Expected JSON (placeholders denote generated values):{\n  \"error\": {\n    \"code\": \"UNAUTHORIZED\",\n    \"message\": \"Authentication required\"\n  }\n}"
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP status', () => pm.response.to.have.status(401));",
              "const body = pm.response.json();",
              "pm.test('Safe error', () => pm.expect(body).to.deep.equal({\"error\":{\"code\":\"UNAUTHORIZED\",\"message\":\"Authentication required\"}}));"
            ]
          }
        }
      ]
    },
