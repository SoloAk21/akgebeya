{
  "info": {
    "name": "AkGebeya Listing Draft Foundation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Private local Step 4.6 verification. Run sequentially with isolated fixtures; never sync/export populated session variables."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1/listings"
    },
    {
      "key": "fixtureUrl",
      "value": ""
    },
    {
      "key": "fixtureKey",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('ownerToken')) {",
          "pm.sendRequest({url:pm.variables.get('fixtureUrl')+'/credentials',method:'POST',header:{Authorization:'Bearer '+pm.variables.get('fixtureKey')}},function(error,response){",
          "if(error || response.code!==200) throw new Error('Private fixture unavailable');",
          "const data=response.json();Object.keys(data.tokens).forEach(name=>pm.variables.set(name+'Token',data.tokens[name]));pm.variables.set('nonDraftId',data.nonDraftId);",
          "});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Unauthenticated",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Expected HTTP 401.\nExpected JSON (placeholders represent server-generated or previously supplied fields):\n{\n  \"error\": {\n    \"code\": \"UNAUTHORIZED\",\n    \"message\": \"Authentication required\"\n  }\n}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status',()=>pm.response.to.have.status(401));",
              "const body=pm.response.json();",
              "pm.test('Safe error',()=>pm.expect(body).to.deep.equal({\"error\":{\"code\":\"UNAUTHORIZED\",\"message\":\"Authentication required\"}}));"
            ]
          }
        }
      ],
      "response": []
    },
