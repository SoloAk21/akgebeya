        "description": "Expected HTTP 201.\nExpected JSON (placeholders represent server-generated or previously supplied fields):\n{\n  \"listing\": {\n    \"id\": \"<uuid>\",\n    \"category\": \"<selected category or null>\",\n    \"type\": \"<selected purpose or null>\",\n    \"propertyType\": \"<selected type or null>\",\n    \"titleEn\": \"<supplied value or null>\",\n    \"titleAm\": \"<supplied value or null>\",\n    \"descriptionEn\": \"<supplied value or null>\",\n    \"descriptionAm\": \"<supplied value or null>\",\n    \"price\": \"<decimal string or null>\",\n    \"currency\": \"ETB\",\n    \"bedrooms\": null,\n    \"bathrooms\": null,\n    \"areaSqm\": null,\n    \"location\": \"<supplied location object or null>\",\n    \"status\": \"DRAFT\",\n    \"createdAt\": \"<timestamp>\",\n    \"updatedAt\": \"<timestamp>\",\n    \"etag\": \"\\\"<opaque revision>\\\"\"\n  }\n}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected status',()=>pm.response.to.have.status(201));",
              "const body=pm.response.json();",
              "pm.test('DRAFT only with ETag',()=>{pm.expect(body.listing.status).to.equal('DRAFT');pm.expect(body.listing).not.to.have.property('payments');pm.expect(pm.response.headers.get('ETag')).to.equal(body.listing.etag);});",
              "pm.test('Genuine NULL draft fields',()=>['category','type','propertyType','titleEn','titleAm','descriptionEn','descriptionAm','location','price'].forEach(k=>pm.expect(body.listing[k]).to.equal(null)));",
              "pm.variables.set('draftId',body.listing.id);",
              "pm.variables.set('etag',body.listing.etag);",
              "pm.variables.set('initialEtag',body.listing.etag);"
            ]
          }
        }
      ],
      "response": []
