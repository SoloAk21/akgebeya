          }
        ],
        "description": "Expected HTTP 200. Expected JSON shape:\n{\n  \"listing\": {\n    \"id\": \"<UUID>\",\n    \"status\": \"AI_ASSIST\",\n    \"etag\": \"<quoted revision>\",\n    \"titleEn\": \"<English text>\",\n    \"titleAm\": \"<Amharic text>\",\n    \"descriptionEn\": \"<English text>\",\n    \"descriptionAm\": \"<Amharic text>\",\n    \"category\": \"RESIDENTIAL\",\n    \"type\": \"SALE\",\n    \"propertyType\": \"HOUSE\",\n    \"price\": \"100.00\",\n    \"currency\": \"ETB\",\n    \"bedrooms\": 2,\n    \"bathrooms\": 1,\n    \"areaSqm\": \"80.00\",\n    \"location\": \"<unchanged stored location>\",\n    \"createdAt\": \"<UTC>\",\n    \"updatedAt\": \"<UTC>\"\n  }\n}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 200) pm.execution.setNextRequest(null);",
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(200));",
              "const body=pm.response.json();",
              "pm.test('Expected lifecycle',()=>pm.expect(body.listing.status).to.equal('AI_ASSIST'));",
              "pm.test('ETag matches body',()=>pm.expect(pm.response.headers.get('ETag')).to.equal(body.listing.etag));",
              "pm.variables.set('revision',body.listing.etag);",
              "const facts=((({titleEn,titleAm,descriptionEn,descriptionAm,status,updatedAt,etag,...rest})=>rest)(body.listing));",
              "if(!pm.variables.get('listingFacts'))pm.variables.set('listingFacts',JSON.stringify(facts));else pm.test('Facts unchanged',()=>pm.expect(facts).to.deep.equal(JSON.parse(pm.variables.get('listingFacts'))));",
              "pm.test('Bilingual content',()=>{for(const key of ['titleEn','titleAm','descriptionEn','descriptionAm'])pm.expect(body.listing[key]).to.be.a('string').and.not.empty;pm.expect(body.listing.titleEn.length).to.be.at.most(200);pm.expect(body.listing.titleAm.length).to.be.at.most(200);});"
            ]
          }
        }
