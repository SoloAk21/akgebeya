{
  "info": {
    "name": "AkGebeya Step 4.8 Listing AI Assist",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run sequentially using local unsynced session variables. Two-phase generation; no keys in collection. Successful generation calls the configured backend Gemini model. Error simulations run in the separate development verifier."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.variables.get('ownerToken')) {",
          "pm.sendRequest({url:pm.variables.get('fixtureUrl')+'/credentials',method:'POST',header:{Authorization:'Bearer '+pm.variables.get('fixtureKey')}},function(error,response){",
          "if(error || response.code!==200) throw new Error('Private fixture unavailable');",
          "const data=response.json();Object.keys(data.tokens).forEach(name=>pm.variables.set(name+'Token',data.tokens[name]));",
          "});",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1/listings"
    }
  ],
  "item": [
    {
      "name": "Create test draft",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{ownerToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"category\":\"RESIDENTIAL\",\"type\":\"SALE\",\"propertyType\":\"HOUSE\",\"titleEn\":\"House for sale in Addis Ababa\",\"descriptionEn\":\"House in Addis Ababa.\",\"price\":\"100.00\",\"bedrooms\":2,\"bathrooms\":1,\"areaSqm\":\"80.00\",\"location\":{\"regionEn\":\"Addis Ababa\",\"cityEn\":\"Addis Ababa\"}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": "Expected HTTP 201. Expected JSON shape:\n{\n  \"listing\": {\n    \"id\": \"<UUID>\",\n    \"status\": \"DRAFT\",\n    \"etag\": \"<quoted revision>\",\n    \"titleEn\": \"<English text>\",\n    \"titleAm\": null,\n    \"descriptionEn\": \"<English text>\",\n    \"descriptionAm\": null,\n    \"category\": \"RESIDENTIAL\",\n    \"type\": \"SALE\",\n    \"propertyType\": \"HOUSE\",\n    \"price\": \"100.00\",\n    \"currency\": \"ETB\",\n    \"bedrooms\": 2,\n    \"bathrooms\": 1,\n    \"areaSqm\": \"80.00\",\n    \"location\": \"<unchanged stored location>\",\n    \"createdAt\": \"<UTC>\",\n    \"updatedAt\": \"<UTC>\"\n  }\n}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code !== 201) pm.execution.setNextRequest(null);",
              "pm.test('Expected HTTP status',()=>pm.response.to.have.status(201));",
              "const body=pm.response.json();",
              "pm.test('Expected lifecycle',()=>pm.expect(body.listing.status).to.equal('DRAFT'));",
              "pm.test('ETag matches body',()=>pm.expect(pm.response.headers.get('ETag')).to.equal(body.listing.etag));",
              "pm.variables.set('id',body.listing.id);",
              "pm.variables.set('revision',body.listing.etag);",
              "pm.variables.set('initialRevision',body.listing.etag);",
              "const facts=((({titleEn,titleAm,descriptionEn,descriptionAm,status,updatedAt,etag,...rest})=>rest)(body.listing));",
              "if(!pm.variables.get('listingFacts'))pm.variables.set('listingFacts',JSON.stringify(facts));else pm.test('Facts unchanged',()=>pm.expect(facts).to.deep.equal(JSON.parse(pm.variables.get('listingFacts'))));"
            ]
          }
        }
      ],
      "response": []
    },
