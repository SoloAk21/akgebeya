{
  "info": {
    "name": "AkGebeya Chapa Webhook, Reconciliation and Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Database-only notifications after authoritative verification. Run via the local deterministic runner for pending/failure/mismatch/network cases; never fabricate live gateway state. No automatic publication. Private local environment values only."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "id",
      "value": ""
    },
    {
      "key": "referenceToken",
      "value": ""
    },
    {
      "key": "webhookToken",
      "value": ""
    },
    {
      "key": "ownerToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if(!pm.variables.get('ownerToken') && pm.variables.get('fixtureUrl')){",
          "pm.sendRequest({url:pm.variables.get('fixtureUrl')+'/credentials',method:'POST',header:{Authorization:'Bearer '+pm.variables.get('fixtureKey')}},(e,r)=>{if(e||r.code!==200)throw new Error('Private fixture unavailable');const d=r.json();Object.entries(d.tokens).forEach(([k,v])=>pm.variables.set(k+'Token',v));pm.variables.set('id',d.nonDraftId);});",
          "}"
        ]
      }
    }
  ],
  "item": [
