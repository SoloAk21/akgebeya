    {
      "name": "Valid Google authentication",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/google",
        "body": {
          "mode": "raw",
          "raw": "{\"idToken\":\"{{idToken}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({url: pm.collectionVariables.get('fixtureUrl') + '/credential/valid', method:'POST', header:{Authorization:'Bearer ' + pm.collectionVariables.get('fixtureKey')}}, (err,res) => { if(err || res.code !== 200) throw new Error('Private credential unavailable'); pm.variables.set('idToken',res.json().idToken); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('No response caching', () => pm.expect(pm.response.headers.get('Cache-Control')).to.eql('no-store'));",
              "pm.test('Session response only', () => pm.expect(Object.keys(pm.response.json()).sort()).to.eql(['expiresAt','token']));",
              "pm.collectionVariables.set('sessionToken',pm.response.json().token);",
              "pm.sendRequest({url:pm.collectionVariables.get('fixtureUrl')+'/session',method:'POST',header:{Authorization:'Bearer '+pm.collectionVariables.get('fixtureKey'),'Content-Type':'application/json'},body:{mode:'raw',raw:JSON.stringify({token:pm.response.json().token})}},(err,res)=>{pm.test('Neon session ownership verified',()=>{pm.expect(err).to.eql(null);pm.expect(res.code).to.eql(200);});});"
            ]
          }
        }
      ]
