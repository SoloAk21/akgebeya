          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": []
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Expected HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Safe JSON error', () => pm.expect(pm.response.json()).to.eql({\"error\":{\"code\":\"INVALID_JSON\",\"message\":\"Invalid JSON body\"}}));"
