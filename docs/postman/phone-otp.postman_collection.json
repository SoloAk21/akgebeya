{
  "info": {
    "name": "AkGebeya Step 4.3 Phone OTP — local verification",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run only with scripts/verify-phone.ts. OTPs remain in memory in a private development fixture. No production OTP-disclosure endpoint or real SMS provider exists. Each request documents exact expected status."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1/auth"
    },
    {
      "key": "fixtureUrl",
      "value": ""
    },
    {
      "key": "fixtureKey",
      "value": ""
    },
    {
      "key": "phone",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "otpValue",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function fixture(action, extra, done) {",
          "  pm.sendRequest({ url: pm.collectionVariables.get('fixtureUrl') + '/' + action, method: 'POST',",
          "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('fixtureKey') },",
          "    body: { mode: 'raw', raw: JSON.stringify(Object.assign({ phone: pm.collectionVariables.get('phone') }, extra)) } },",
          "    function(error, response) {",
          "      if (error || !response || response.code !== 200) throw new Error('Development fixture failed');",
          "      done(response.json());",
          "    });",
          "}",
          "const name = pm.info.requestName;",
          "if (['Repeat OTP request','Expiry OTP request','Attempt-limit OTP request'].includes(name)) {",
          "  fixture('allow-resend', {}, function() {});",
          "}",
          "if (name.startsWith('Wrong OTP') || ['Correct OTP','Repeat OTP verification','Expired OTP','Exhausted OTP'].includes(name)) {",
          "  fixture('delivery', { challengeId: pm.collectionVariables.get('challengeId') }, function(body) {",
          "    const code = body.otp;",
          "    pm.collectionVariables.set('otpValue', name.startsWith('Wrong OTP') ? String((Number(code[0]) + 1) % 10) + code.slice(1) : code);",
          "    if (name === 'Expired OTP') fixture('expire', {}, function() {});",
          "  });",
          "}",
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function fixture(action, extra, done) {",
          "  pm.sendRequest({ url: pm.collectionVariables.get('fixtureUrl') + '/' + action, method: 'POST',",
          "    header: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + pm.collectionVariables.get('fixtureKey') },",
          "    body: { mode: 'raw', raw: JSON.stringify(Object.assign({ phone: pm.collectionVariables.get('phone') }, extra)) } },",
          "    function(error, response) {",
          "      if (error || !response || response.code !== 200) throw new Error('Development fixture failed');",
          "      done(response.json());",
          "    });",
          "}",
          "const expected = {\"Invalid phone\":400,\"Request OTP\":200,\"Resend cooldown\":429,\"Wrong OTP\":401,\"Correct OTP\":200,\"Current user\":200,\"Reused OTP\":401,\"Logout\":200,\"Current user after logout\":401,\"Current user without token\":401,\"Repeat OTP request\":200,\"Repeat OTP verification\":200,\"Expiry OTP request\":200,\"Expired OTP\":401,\"Attempt-limit OTP request\":200,\"Wrong OTP attempt 1\":401,\"Wrong OTP attempt 2\":401,\"Wrong OTP attempt 3\":401,\"Wrong OTP attempt 4\":401,\"Wrong OTP attempt 5\":401,\"Exhausted OTP\":401};",
          "const name = pm.info.requestName;",
          "pm.test('Expected HTTP status', function() { pm.response.to.have.status(expected[name]); });",
          "const body = pm.response.json();",
          "if (expected[name] >= 400) {",
          "  const code = expected[name] === 400 ? 'BAD_REQUEST' : expected[name] === 429 ? 'TOO_MANY_REQUESTS' : 'UNAUTHORIZED';",
          "  pm.test('Safe JSON error', function() { pm.expect(body.error.code).to.equal(code); });",
          "}",
          "if (name.endsWith('OTP request') || name === 'Request OTP') {",
          "  pm.test('Challenge metadata only', function() {",
          "    pm.expect(Object.keys(body).sort().join(',')).to.equal('challengeId,expiresAt,resendAvailableAt');",
          "  });",
          "  pm.collectionVariables.set('challengeId', body.challengeId);",
          "}",
          "if (name === 'Correct OTP' || name === 'Repeat OTP verification') {",
          "  pm.test('Session response only', function() {",
          "    pm.expect(Object.keys(body).sort().join(',')).to.equal('expiresAt,token');",
          "    pm.expect(typeof body.token).to.equal('string');",
          "  });",
          "  pm.collectionVariables.set('token', body.token);",
          "  fixture('session', { token: body.token, expiresAt: body.expiresAt }, function(result) {",
          "    pm.test('Neon OTP/session hashes and user identity verified', function() { pm.expect(result.status).to.equal('ok'); });",
          "  });",
          "}",
          "if (name === 'Current user') {",
          "  pm.test('Current verified phone and role', function() {",
          "    pm.expect(body.user.phone).to.equal(pm.collectionVariables.get('phone'));",
          "    pm.expect(body.user.role).to.equal('USER');",
          "  });",
          "}",
          "if (name === 'Logout') fixture('revoked', { token: pm.collectionVariables.get('token') }, function(result) {",
          "  pm.test('Neon session revoked', function() { pm.expect(result.status).to.equal('ok'); });",
          "});",
          "if (name === 'Exhausted OTP') fixture('exhausted', {}, function(result) {",
          "  pm.test('Atomic attempt limit persisted', function() { pm.expect(result.status).to.equal('ok'); });",
          "});",
          ""
        ]
      }
    }
  ],
