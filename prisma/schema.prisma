generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["akgebeya_foundation"]
}

// One controlled operational record; no speculative product schema.
model FoundationProbe {
  id        String   @id @db.VarChar(32)
  message   String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("foundation_probe")
  @@schema("akgebeya_foundation")
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  displayName  String?   @db.VarChar(80)
  isAdmin      Boolean   @default(false)
  passwordHash String    @db.VarChar(256)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  providerApplication ProviderApplication?
  providerReviews ProviderReview[]
  location AccountLocation?
  listingDrafts ListingDraft[]

  @@map("account")
  @@schema("akgebeya_foundation")
}

model ListingDraft {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  requestId String @db.Uuid
  title String @db.VarChar(120)
  transactionType String @db.VarChar(4)
  propertyType String @db.VarChar(10)
  status String @default("DRAFT") @db.VarChar(8)
  creationPayload Json @db.JsonB
  description String @default("") @db.Text
  priceEtb Decimal? @db.Decimal(14, 2)
  areaSqm Decimal? @db.Decimal(11, 2)
  bedrooms Int?
  bathrooms Int?
  version Int @default(1)
  mediaVersion Int @default(1)
  media ListingMedia[]
  aiContent ListingAiContent?
  payment ListingPayment?
  countryId String @db.VarChar(2)
  regionId String @db.VarChar(40)
  cityId String @db.VarChar(40)
  subcityId String @db.VarChar(40)
  latitude Float @db.DoublePrecision
  longitude Float @db.DoublePrecision
  address Json? @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, requestId])
  @@index([accountId, createdAt, id])
  @@map("listing_draft")
  @@schema("akgebeya_foundation")
}

model ListingPayment {
  id String @id @default(uuid()) @db.Uuid
  listingId String @unique @db.Uuid
  requestId String @db.Uuid
  reference String @unique @db.VarChar(40)
  sourceVersion Int
  mediaVersion Int
  amount Decimal @db.Decimal(14, 2)
  currency String @db.VarChar(3)
  policyRevision String @db.VarChar(100)
  status String @default("INITIALIZING") @db.VarChar(12)
  checkoutUrl String? @db.VarChar(2048)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  listing ListingDraft @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_payment")
  @@schema("akgebeya_foundation")
}

model ListingAiContent {
  listingId String @id @db.Uuid
  requestId String @db.Uuid
  sourceVersion Int
  copy Json @db.JsonB
  model String @db.VarChar(100)
  generatedAt DateTime @default(now()) @db.Timestamptz(3)
  listing ListingDraft @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_ai_content")
  @@schema("akgebeya_foundation")
}

model ListingMedia {
  id String @id @default(uuid()) @db.Uuid
  listingId String @db.Uuid
  requestId String @db.Uuid
  sha256 String @db.Char(64)
  position Int
  width Int
  height Int
  byteSize Int
  bytes Bytes @db.ByteA
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  listing ListingDraft @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, requestId])
  @@unique([listingId, position])
  @@map("listing_media")
  @@schema("akgebeya_foundation")
}

model AccountLocation {
  accountId String @id @db.Uuid
  countryId String @db.VarChar(2)
  regionId String @db.VarChar(40)
  cityId String @db.VarChar(40)
  subcityId String @db.VarChar(40)
  latitude Float @db.DoublePrecision
  longitude Float @db.DoublePrecision
  confirmed Boolean
  address Json? @db.JsonB
  point Unsupported("geometry(Point,4326)") @default(dbgenerated())
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_location")
  @@schema("akgebeya_foundation")
}

model Session {
  tokenHash String   @id @db.Char(64)
  accountId String  @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("session")
  @@schema("akgebeya_foundation")
}

model AuthAttempt {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_attempt")
  @@schema("akgebeya_foundation")
}

enum ProviderType {
  OWNER
  BROKER
  AGENT
  AGENCY
  DEVELOPER

  @@schema("akgebeya_foundation")
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("akgebeya_foundation")
}

model ProviderApplication {
  accountId    String @id @db.Uuid
  providerType ProviderType
  status       ProviderVerificationStatus @default(PENDING)
  submittedAt  DateTime @default(now()) @db.Timestamptz(3)
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  review       ProviderReview?

  @@map("provider_application")
  @@schema("akgebeya_foundation")
}

model ProviderReview {
  accountId String @id @db.Uuid
  reviewerId String @db.Uuid
  decision ProviderVerificationStatus
  reason String? @db.VarChar(500)
  reviewedAt DateTime @default(now()) @db.Timestamptz(3)
  application ProviderApplication @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  reviewer Account @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@map("provider_review")
  @@schema("akgebeya_foundation")
}
