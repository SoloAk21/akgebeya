generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  schemas  = ["akgebeya_foundation"]
}

// One controlled operational record; no speculative product schema.
model FoundationProbe {
  id        String   @id @db.VarChar(32)
  message   String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("foundation_probe")
  @@schema("akgebeya_foundation")
}

model Account {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(254)
  displayName  String?   @db.VarChar(80)
  isAdmin      Boolean   @default(false)
  passwordHash String    @db.VarChar(256)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  providerApplication ProviderApplication?
  providerReviews ProviderReview[]
  location AccountLocation?

  @@map("account")
  @@schema("akgebeya_foundation")
}

model AccountLocation {
  accountId String @id @db.Uuid
  countryId String @db.VarChar(2)
  regionId String @db.VarChar(40)
  cityId String @db.VarChar(40)
  subcityId String @db.VarChar(40)
  latitude Float @db.DoublePrecision
  longitude Float @db.DoublePrecision
  confirmed Boolean
  address Json? @db.JsonB
  point Unsupported("geometry(Point,4326)") @default(dbgenerated())
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_location")
  @@schema("akgebeya_foundation")
}

model Session {
  tokenHash String   @id @db.Char(64)
  accountId String  @db.Uuid
  expiresAt DateTime @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([expiresAt])
  @@map("session")
  @@schema("akgebeya_foundation")
}

model AuthAttempt {
  key       String   @id @db.Char(64)
  count     Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("auth_attempt")
  @@schema("akgebeya_foundation")
}

enum ProviderType {
  OWNER
  BROKER
  AGENT
  AGENCY
  DEVELOPER

  @@schema("akgebeya_foundation")
}

enum ProviderVerificationStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("akgebeya_foundation")
}

model ProviderApplication {
  accountId    String @id @db.Uuid
  providerType ProviderType
  status       ProviderVerificationStatus @default(PENDING)
  submittedAt  DateTime @default(now()) @db.Timestamptz(3)
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  review       ProviderReview?

  @@map("provider_application")
  @@schema("akgebeya_foundation")
}

model ProviderReview {
  accountId String @id @db.Uuid
  reviewerId String @db.Uuid
  decision ProviderVerificationStatus
  reason String? @db.VarChar(500)
  reviewedAt DateTime @default(now()) @db.Timestamptz(3)
  application ProviderApplication @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  reviewer Account @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([reviewerId])
  @@map("provider_review")
  @@schema("akgebeya_foundation")
}
