{
  "name": "akgebeya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23",
    "npm": ">=10 <11"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "dev": "concurrently --kill-others --names api,web \"npm run dev --workspace @akgebeya/api\" \"npm run dev --workspace @akgebeya/web\"",
    "test": "node --import tsx --test tests/*.test.mjs",
    "build": "npm run build --workspaces",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.3",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
